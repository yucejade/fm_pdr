[Unit]
Description=PDR Test Service
After=network.target
ConditionPathExists=/home/kevin/fm_pdr/build/package/bin/PDRTest

[Service]
Type=simple
WorkingDirectory=/home/kevin/fm_pdr/build/package/bin
Environment=LD_LIBRARY_PATH=/home/kevin/fm_pdr/build/package/lib
User=kevin

# 清理残留文件
# ExecStartPre=/bin/rm -fr Trajectory.csv output_sensor_data

# 执行模型生成
ExecStartPre=/bin/bash -c '\
    if [ ! -f "model.dat" ]; then \
        echo "Generating model.dat..."; \
        ./PDRTest -t test_data/train_data -o ./Trajectory.csv; \
    fi'

# 启动主程序
ExecStart=/home/kevin/fm_pdr/build/package/bin/PDRTest \
    -x 123.45001915081717 \
    -y 41.71512697704802 \
    -o ./Trajectory.csv \
    -r ./output_sensor_data \
    -e

Restart=always
RestartSec=30s
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target

